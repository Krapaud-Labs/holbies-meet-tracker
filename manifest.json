{
  "manifest_version": 3,
  "name": "Holbies Meet Tracker",
  "version": "0.1.0",
  "description": "Prépare le suivi de présence des réunions Google Meet.",
  "permissions": [
    "identity",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://meet.googleapis.com/*",
    "https://sheets.googleapis.com/*",
    "https://walter-bringing-greatest-warming.trycloudflare.com/*"
  ],
  "oauth2": {
    "client_id": "611287747685-ta67qr1faesv1mjk0q5k53qtr7ai3di4.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/meetings.space.readonly",
      "https://www.googleapis.com/auth/calendar.events.readonly",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "action": {
    "default_title": "Holbies Meet Tracker",
    "default_popup": "popup.html"
  }
}
